upstream django {
    server web:8000;
}

# El entrypoint de la imagen nginx hace envsubst sobre este archivo:
# ${DOMINIO} sale de la variable del mismo nombre en .env. No lo edites a mano.

server {
    listen 80;
    server_name ${DOMINIO};

    # Renovación de certificados sin bajar nginx.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;

    client_max_body_size 20M;   # carga múltiple de imágenes de producto

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /static/ {
        alias /var/www/static/;
        expires 30d;
        access_log off;
    }

    # Mientras las imágenes vivan en el volumen local. Cuando migres a Object
    # Storage de OCI, este bloque deja de usarse: las URLs apuntarán al bucket.
    location /media/ {
        alias /var/www/media/;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
